{
  "name": "@cairn/web",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn web app: find co-owners and an operator for a Dash Core v24 shared masternode, read from and written to Dash Platform with proofs.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "CAIRN_LIVE=1 playwright test --grep @live"
  },
  "dependencies": {
    "@cairn/auth": "*",
    "@cairn/contract": "*",
    "@cairn/dapi": "*",
    "@cairn/shares": "*",
    "@cairn/verify": "*",
    "@dashevo/evo-sdk": "5.0.0-rc.8",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.0.0",
    "qr": "^0.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.0",
    "vite": "^7.1.3",
    "vitest": "^3.0.0"
  }
}
