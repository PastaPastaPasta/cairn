{
  "name": "@cairn/contract",
  "version": "0.0.0",
  "private": true,
  "description": "The cairn Dash Platform data contract: schemas, per-network contract ids, typed document models, and PV13-linted query builders.",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cairn.json": "./cairn.json",
    "./deployments.json": "./deployments.json",
    "./queryLint": "./queryLint.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "register:testnet": "node --experimental-transform-types scripts/register.ts testnet"
  },
  "dependencies": {
    "@scure/base": "^2.0.0"
  },
  "devDependencies": {
    "@cairn/auth": "*",
    "@dashevo/evo-sdk": "5.0.0-rc.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
